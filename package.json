{
  "name": "sistema-clasificacion-cap",
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:fullstack": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:electron": "tsc && electron .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\"",
    "build:backend": "cd backend && npx prisma generate && npx tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "rebuild:electron": "npx @electron/rebuild -f -m backend",
    "rebuild:node": "cd backend && npm rebuild",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "tsc",
    "build": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "dist": "npm run build && npm run rebuild:electron && electron-builder --win nsis && npm run rebuild:node"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "concurrently": "^10.0.6",
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cap.clasificacion",
    "productName": "CAP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "electron/**/*.html",
      "frontend/dist/**/*",
      "backend/dist/**/*",
      "backend/package.json",
      "backend/prisma/**/*"
    ],
    "extraResources": [
      { "from": "backend/node_modules", "to": "node_modules" }
    ],
    "win": { "target": "nsis" }
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "electron-log": "^5.4.4",
    "react-bootstrap": "^2.10.10"
  }
}
